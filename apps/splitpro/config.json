{
    "name": "SplitPro",
    "id": "splitpro",
    "available": true,
    "short_desc": "Self-hosted expense sharing.",
    "author": "oss-apps",
    "port": 3020,
    "categories": [
        "utilities"
    ],
    "description": "SplitPro is a self-hosted application for sharing and settling expenses.",
    "tipi_version": 1,
    "version": "latest",
    "source": "https://github.com/oss-apps/split-pro",
    "website": "https://splitpro.app",
    "exposable": true,
    "force_expose": false,
    "supported_architectures": [
        "amd64",
        "arm64"
    ],
    "form_fields": [
        {
            "type": "random",
            "label": "Database password",
            "hint": "Automatically generated PostgreSQL password.",
            "required": true,
            "env_variable": "SPLITPRO_DB_PASSWORD"
        },
        {
            "type": "random",
            "label": "NextAuth secret",
            "hint": "Automatically generated authentication secret.",
            "required": true,
            "env_variable": "SPLITPRO_NEXTAUTH_SECRET"
        },
        {
            "type": "text",
            "label": "Authentik client ID",
            "hint": "Copy the client ID from the SplitPro provider in Authentik.",
            "placeholder": "Authentik client ID",
            "required": true,
            "min": 1,
            "max": 255,
            "env_variable": "SPLITPRO_AUTHENTIK_ID"
        },
        {
            "type": "password",
            "label": "Authentik client secret",
            "hint": "Copy the client secret from the SplitPro provider in Authentik.",
            "required": true,
            "min": 1,
            "max": 512,
            "env_variable": "SPLITPRO_AUTHENTIK_SECRET"
        },
        {
            "type": "text",
            "label": "Authentik issuer URL",
            "hint": "Example: https://auth.example.ch/application/o/splitpro — without a trailing slash.",
            "placeholder": "https://auth.example.ch/application/o/splitpro",
            "required": true,
            "min": 10,
            "max": 512,
            "env_variable": "SPLITPRO_AUTHENTIK_ISSUER"
        }
    ]
}
